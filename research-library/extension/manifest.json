{
  "manifest_version": 3,
  "name": "Research Library",
  "version": "0.1.0",
  "description": "Your saved research highlights alongside the original article.",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Open research highlights"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "key": ""
}
